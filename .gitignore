# ============================================
# Terraform
# ============================================

# Local Terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
# These may contain passwords, secrets, IDs, etc.
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc


# ============================================
# Environment Variables / Secrets
# ============================================

.env
.env.*
*.env

# AWS credentials
.aws/
credentials


# ============================================
# Python
# ============================================

.venv/
venv/
env/

__pycache__/
*.py[cod]
*.pyo


# ============================================
# IDE / Editor
# ============================================

.vscode/
.idea/


# ============================================
# Operating System Files
# ============================================

.DS_Store
Thumbs.db


# ============================================
# Logs
# ============================================

*.log
logs/


# ============================================
# Temporary Files
# ============================================

*.tmp
*.temp
*.bak